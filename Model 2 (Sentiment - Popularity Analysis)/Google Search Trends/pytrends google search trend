   "source": [
    "def trends(players, timeframe, season):\n",
    "    ANCHOR = \"LeBron James\"\n",
    "\n",
    "    pytrends = TrendReq(hl='en-US', tz=360)\n",
    "\n",
    "    all_batches = {}\n",
    "    master_anchor_series = None\n",
    "\n",
    "    raw_dir = f\"data/raw/{season}\"\n",
    "    processed_dir = f\"data/processed/{season}\"\n",
    "\n",
    "    os.makedirs(raw_dir, exist_ok=True)\n",
    "    os.makedirs(processed_dir, exist_ok=True)\n",
    "\n",
    "    for i in range(0, len(players), 4):\n",
    "        batch = players[i:i+4]\n",
    "        if ANCHOR not in batch:\n",
    "            batch.append(ANCHOR)\n",
    "        print(f\"\\nbatch {i//4 + 1}: {batch}\")\n",
    "\n",
    "        pytrends.build_payload(\n",
    "            kw_list=batch,\n",
    "            timeframe=timeframe,\n",
    "            geo=\"\",\n",
    "            gprop=\"\"\n",
    "        )\n",
    "\n",
    "        df_raw = pytrends.interest_over_time().drop(columns=[\"isPartial\"])\n",
    "        all_batches[i] = df_raw\n",
    "        file_path = f\"{raw_dir}/raw_batch_{i//4 + 1}.csv\"\n",
    "        df_raw.to_csv(file_path)\n",
    "        print(f\"saved to {file_path}\")\n",
    "\n",
    "        if master_anchor_series is None:\n",
    "            master_anchor_series = df_raw[ANCHOR]\n",
    "\n",
    "        time.sleep(40)\n",
    "\n",
    "    scaled_batches = []\n",
    "    master_anchor_max = master_anchor_series.max()\n",
    "\n",
    "    for batch_index, df in all_batches.items():\n",
    "        batch_anchor = df[ANCHOR]\n",
    "        batch_anchor_max = batch_anchor.max()\n",
    "\n",
    "        scale_factor = master_anchor_max / batch_anchor_max\n",
    "        print(f\"Batch {batch_index//4 + 1} scale factor: {scale_factor:.4f}\")\n",
    "\n",
    "        df_scaled = df * scale_factor\n",
    "        scaled_batches.append(df_scaled)\n",
    "\n",
    "    combined = pd.concat(scaled_batches, axis=1)\n",
    "    combined = combined.loc[:, ~combined.columns.duplicated()]\n",
    "\n",
    "    global_max = combined.max().max()\n",
    "    normalized = combined / global_max * 100\n",
    "\n",
    "    processed_file = f\"{processed_dir}/processed_normalized_{season}.csv\"\n",
    "    normalized.to_csv(processed_file)\n",
    "    print(\"saved\")"
   ]
